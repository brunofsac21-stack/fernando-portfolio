# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: domínios aceitos na verificação (padrão: fernando-portfolio-sable.vercel.app)
TURNSTILE_HOSTNAMES=
# Senha do modo administrador do livro de visitas
ADMIN_SECRET=
# Segredos aleatórios (ex.: openssl rand -hex 32)
JWT_SECRET=
IP_SALT=
